# Datenbank (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host.neon.tech/lehrstellenradar?sslmode=require

# Sicherheit
CRON_SECRET=change-me-min-32-random-chars

# Web Push (generieren mit: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:deine@email.ch

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-Mail (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL=schwester@example.com
EMAIL_FROM=Lehrstellenradar <noreply@deinedomain.ch>

# Favoriten-Alarm (läuft immer, unabhängig vom E-Mail-Setting oben)
# Default: mona.lassoued8@gmail.com — hier überschreibbar
FAVORITE_NOTIFICATION_EMAIL=

# App
NEXT_PUBLIC_APP_URL=https://deine-app.vercel.app
